# Supabase Configuration Template
# Copie este arquivo para .env e preencha suas credenciais do Supabase

VITE_SUPABASE_URL=https://sua-url-do-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Chave pública VAPID para notificações push (gere com web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid-aqui
